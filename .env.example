# Public frontend configuration only. Never put secrets in VITE_* values.
#
# mock = deterministic local repositories used for development, visual QA, and
#        explicit production-like pre-backend acceptance.
# api  = real HTTP API repositories. Production defaults to api when this
#        variable is omitted, so production never silently falls back to mock.
VITE_DATA_ADAPTER=mock

# Required when VITE_DATA_ADAPTER=api.
# Example: https://api.example.com/
VITE_API_BASE_URL=
